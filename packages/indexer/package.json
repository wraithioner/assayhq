{
  "name": "@assayhq/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Reorg-safe, resumable indexer for Robinhood Chain: agent (ERC-8004) wallets, stock-token transfers (ERC-8056), Uniswap V3 swaps, Chainlink prices, and unattributed-flow detection. Stores raw events; derives everything else.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "rh-index": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "index": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@assayhq/erc8056": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "viem": "2.21.55"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.10.2",
    "fast-check": "3.23.1",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
